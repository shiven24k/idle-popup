# Cloudflare R2 credentials (developer machine only, never shipped in the app).
# Create an R2 API token with "Object Read & Write" for the bucket:
#   Cloudflare dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=idle-popup-images

# Where the bucket is public: the r2.dev URL or a custom domain.
# The app stores this as "remoteBaseUrl" in config.json.
R2_PUBLIC_BASE_URL=

# Optional. Only needed for --pinterest-board. Get one from
# https://developers.pinterest.com/ (an approved app).
PINTEREST_ACCESS_TOKEN=
